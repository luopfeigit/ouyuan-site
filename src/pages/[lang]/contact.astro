---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import { translations, supportedLanguages } from '../../lib/i18n';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';
const t = translations[currentLang]?.contactPage || translations['en']?.contactPage;
const leadContent = translations[currentLang]?.leadForm || translations['en']?.leadForm;

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": t.title,
  "description": t.subtitle,
  "url": `https://ouyuan.id/${currentLang}/contact/`,
  "mainEntity": {
    "@type": "Organization",
    "name": "OUYUAN Intelligent Technology",
    "telephone": "+86 135 7085 5813",
    "email": "sales@ouyuan.id",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Shenzhen",
      "addressCountry": "CN"
    }
  }
};
---

<BaseLayout title={t.seo.title} description={t.seo.description} lang={currentLang}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <!-- 1. 顶部 Hero -->
  <section class="relative bg-slate-950 text-white pt-24 pb-16 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[35rem] h-[35rem] bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block bg-blue-600/20 text-blue-400 border border-blue-500/30 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 font-mono">
        {t.badge}
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight">
        {t.title}
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </section>

  <!-- 2. 4 大联络渠道网格 -->
  <section class="py-16 bg-slate-900/40 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {t.channels.map((channel: any) => (
          <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 hover:border-blue-500/40 transition duration-200 flex flex-col justify-between">
            <div>
              <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-slate-400 mb-2">
                {channel.title}
              </h2>
              <div class="text-base font-black text-white font-mono break-words mb-3">
                {channel.value}
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {channel.desc}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800">
              <a 
                href={channel.link} 
                class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-400 hover:text-blue-300 transition"
              >
                <span>{channel.action}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- SLA 承诺横幅 -->
      <div class="mt-12 bg-gradient-to-r from-blue-950/60 to-slate-900 border border-blue-900/40 rounded-2xl p-6 sm:p-8 flex items-center gap-6">
        <div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center font-black text-xl shrink-0">
          ✓
        </div>
        <div>
          <h3 class="text-base font-bold text-white mb-1">{t.slaBanner.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed max-w-4xl">{t.slaBanner.desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 核心询盘留资表单 -->
  <LeadForm content={leadContent} />
  <WhatsAppFloating />
</BaseLayout>