---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import { translations, supportedLanguages } from '../../lib/i18n';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';
const t = translations[currentLang]?.aboutPage || translations['en'].aboutPage;
const leadContent = translations[currentLang]?.leadForm || translations['en'].leadForm;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `https://ouyuan.id/${currentLang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": `https://ouyuan.id/${currentLang}/about/`
    }
  ]
};
---

<BaseLayout title={t.seo.title} description={t.seo.description} lang={currentLang}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- 1. Hero 顶部大图与品牌使命 -->
  <section class="relative bg-slate-950 text-white pt-24 pb-16 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[35rem] h-[35rem] bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block bg-blue-600/20 text-blue-400 border border-blue-500/30 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 font-mono">
        {t.badge}
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight">
        {t.title}
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </section>

  <!-- 2. 工厂硬实力关键数字看板 -->
  <section class="py-12 bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {t.stats.map((stat: { value: string; label: string }) => (
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-black text-white font-mono text-blue-400 mb-1">{stat.value}</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 三大工程制造支柱 -->
  <section class="py-20 bg-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-400 font-mono">Manufacturing Pillars</span>
        <h2 class="text-3xl font-black text-white mt-2 tracking-tight">Engineered for Industrial Longevity</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {t.pillars.map((pillar: { title: string; desc: string }, index: number) => (
          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-8 hover:border-slate-700 transition">
            <div class="w-12 h-12 rounded-2xl bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center justify-center font-mono font-bold text-lg mb-6">
              0{index + 1}
            </div>
            <h3 class="text-lg font-bold text-white mb-3">{pillar.title}</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 发展历程时间轴 (Milestones) -->
  <section class="py-20 bg-slate-900/40 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-black text-white tracking-tight">{t.timelineTitle}</h2>
      </div>

      <div class="relative border-l border-slate-800 ml-4 md:ml-32 space-y-12">
        {t.milestones.map((item: { year: string; event: string }) => (
          <div class="relative pl-8 group">
            <div class="absolute -left-2.5 top-1.5 w-5 h-5 rounded-full bg-slate-950 border-4 border-blue-500 group-hover:scale-125 transition-transform"></div>
            <div class="md:absolute md:-left-28 md:top-1 font-mono font-bold text-blue-400 text-sm mb-1 md:mb-0">
              {item.year}
            </div>
            <p class="text-sm text-slate-300 leading-relaxed max-w-xl">{item.event}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 底部左右分栏询盘表单 -->
  <LeadForm content={leadContent} />
  <WhatsAppFloating />
</BaseLayout>