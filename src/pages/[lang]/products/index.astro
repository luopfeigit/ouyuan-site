---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import WhatsAppFloating from '../../../components/WhatsAppFloating.astro';

import { fetchFromWP, GET_MACHINES_QUERY } from '../../../lib/wp';
import { translations, supportedLanguages } from '../../../lib/i18n';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';
const t = translations[currentLang]?.productsArchive || translations['en'].productsArchive;
const leadContent = translations[currentLang]?.leadForm || translations['en'].leadForm;

let machines: any[] = [];
try {
  const data = await fetchFromWP(GET_MACHINES_QUERY);
  machines = data?.posts?.nodes || [];
} catch (e) {
  console.error('WP API 获取机型失败，使用兜底数据:', e);
  machines = [
    {
      title: "Flagship 4th Gen Dual-Chamber (OYTK2504-2)",
      slug: "4th-gen-flagship-series-oytk2504-2",
      machineSpecs: {
        screenSize: '21.5" HD Touchscreen',
        chambersCount: 2,
        washMethod: "Pure Water + High Pressure Mist + UV-C + Ozone",
        powerConsumption: "2100W",
        dimensions: "650x1790x550 mm",
        netWeight: "115 kg"
      }
    },
    {
      title: "Commercial Standard Single-Chamber (OYTK2501-1)",
      slug: "commercial-standard-single-chamber-oytk2501-1",
      machineSpecs: {
        screenSize: '10.1" Control Display',
        chambersCount: 1,
        washMethod: "Atomized Wash + Hot Air Vortex + Medical Ozone",
        powerConsumption: "1400W",
        dimensions: "520x1650x480 mm",
        netWeight: "78 kg"
      }
    },
    {
      title: "Compact Transit Kiosk Series (OYTK2500-C)",
      slug: "compact-transit-kiosk-series-oytk2500-c",
      machineSpecs: {
        screenSize: '7" Fast Touch Interface',
        chambersCount: 1,
        washMethod: "Rapid Cold Ozone + UV Disinfection",
        powerConsumption: "900W",
        dimensions: "450x1500x420 mm",
        netWeight: "62 kg"
      }
    }
  ];
}

// 组织 Schema.org ItemList 结构化数据
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.title,
  "description": t.subtitle,
  "itemListElement": machines.map((machine, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://ouyuan.id/${currentLang}/products/${machine.slug}`,
    "name": machine.title
  }))
};
---

<BaseLayout title={t.seo?.title} description={t.seo?.description} lang={currentLang}>
  <!-- Schema.org 结构化数据注入 -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- 1. 产品归档页 Header -->
  <section class="relative bg-slate-950 text-white pt-20 pb-16 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[30rem] h-[30rem] bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block bg-blue-600/20 text-blue-400 border border-blue-500/30 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-4">
        {t.badge}
      </span>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white max-w-3xl mx-auto leading-tight">
        {t.title}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </section>

  <!-- 2. 产品列表主体网格 -->
  <section class="py-20 bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {machines.map((machine) => {
          const specs = machine.machineSpecs || {};
          const imgUrl = machine.featuredImage?.node?.sourceUrl;
          const imgAlt = machine.featuredImage?.node?.altText || machine.title;

          return (
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-500/10 transition duration-300 flex flex-col justify-between group">
              <div>
                <!-- 设备高清悬浮图展示区 -->
                <div class="bg-slate-950/80 border border-slate-800/80 rounded-2xl h-64 flex items-center justify-center p-6 mb-6 relative overflow-hidden group-hover:border-slate-700 transition">
                  <div class="absolute inset-0 bg-gradient-to-b from-blue-600/5 to-transparent pointer-events-none"></div>
                  {imgUrl ? (
                    <img 
                      src={imgUrl} 
                      alt={imgAlt} 
                      class="max-h-full max-w-full object-contain drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex flex-col items-center justify-center text-slate-500">
                      <svg class="w-12 h-12 mb-2 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      <span class="text-xs font-mono">{machine.title}</span>
                    </div>
                  )}
                </div>

                <div class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-blue-400 bg-blue-950/60 border border-blue-800/50 px-2.5 py-0.5 rounded-full mb-3">
                  <span>●</span> {specs.chambersCount || 1} Chamber Configuration
                </div>

                <h2 class="text-xl font-bold text-white group-hover:text-blue-400 transition tracking-tight">
                  {machine.title}
                </h2>

                <!-- 核心参数指标卡 -->
                <div class="mt-6 space-y-2.5 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
                  <div class="flex justify-between items-center py-1">
                    <span class="text-slate-500">Interface Display:</span>
                    <span class="font-medium text-slate-300">{specs.screenSize || '21.5" Touchscreen'}</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-t border-slate-800/40">
                    <span class="text-slate-500">Disinfection Tech:</span>
                    <span class="font-medium text-emerald-400">UV-C + Medical Ozone</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-t border-slate-800/40">
                    <span class="text-slate-500">Rated Power:</span>
                    <span class="font-medium text-slate-300">{specs.powerConsumption || "2100W"}</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-t border-slate-800/40">
                    <span class="text-slate-500">Dimensions (WxHxD):</span>
                    <span class="font-mono text-slate-300">{specs.dimensions || "650x1790x550 mm"}</span>
                  </div>
                </div>
              </div>

              <!-- 双按钮行动转化 -->
              <div class="mt-8 pt-4 border-t border-slate-800/80 grid grid-cols-2 gap-3">
                <a 
                  href={`/${currentLang}/products/${machine.slug}`}
                  class="text-center bg-slate-800 hover:bg-slate-700 text-white font-bold py-3 rounded-xl text-xs transition duration-200 border border-slate-700"
                >
                  {t.ctaDetail}
                </a>
                <a 
                  href="#contact-form" 
                  class="text-center bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold py-3 rounded-xl text-xs transition duration-200 shadow-md shadow-blue-500/20"
                >
                  {t.ctaQuote}
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- 3. OEM / ODM 定制背书横幅 -->
      <div class="mt-20 rounded-3xl bg-gradient-to-r from-blue-950/80 via-slate-900 to-slate-950 border border-blue-900/40 p-8 sm:p-12 relative overflow-hidden flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl text-center lg:text-left">
          <h3 class="text-2xl font-black text-white tracking-tight">
            {t.customBanner.title}
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            {t.customBanner.desc}
          </p>
        </div>
        <a 
          href="#contact-form" 
          class="shrink-0 inline-flex items-center gap-2 bg-white hover:bg-slate-100 text-slate-950 font-black px-8 py-4 rounded-xl text-sm transition duration-200 shadow-xl"
        >
          <span>{t.customBanner.btn}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- 4. 底部商业线索表单 -->
  <LeadForm content={leadContent} />

  <!-- 5. 悬浮沟通按钮 -->
  <WhatsAppFloating />
</BaseLayout>