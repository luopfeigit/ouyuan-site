---
interface Props {
  content: {
    badge: string;
    title: string;
    subtitle: string;
    items: Array<{
      q: string;
      a: string;
    }>;
  };
}

const { content } = Astro.props;

// 生成 Google 认可的 FAQPage 结构化数据
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": content.items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<!-- Schema.org JSON-LD 结构化数据 -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-20 bg-white border-t border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <span class="inline-block bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-4">
        {content.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {content.title}
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        {content.subtitle}
      </p>
    </div>

    <!-- FAQ 折叠列表 -->
    <div class="space-y-4">
      {content.items.map((item, index) => (
        <details class="group bg-slate-50 border border-slate-200 rounded-xl p-5 open:bg-white open:ring-2 open:ring-blue-600/20 transition-all duration-200">
          <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none select-none text-base sm:text-lg">
            <span class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded">
                Q{index + 1}
              </span>
              <span>{item.q}</span>
            </span>
            <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 group-open:text-blue-600 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-3 border-t border-slate-100 text-sm sm:text-base text-slate-600 leading-relaxed pl-9">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>