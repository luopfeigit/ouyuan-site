---
interface Props {
  content: {
    badge?: string;
    title?: string;
    subtitle?: string;
    ctaSpecs?: string;
    ctaQuote?: string;
  };
  currentLang?: string;
  heroImageUrl?: string;
  heroImageAlt?: string;
}

const { content, currentLang = 'en', heroImageUrl, heroImageAlt } = Astro.props;
---

<section class="relative bg-slate-950 text-white pt-12 pb-20 lg:pt-20 lg:pb-32 overflow-hidden border-b border-slate-800/80">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[36rem] h-[36rem] bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[24rem] h-[24rem] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- 左侧文案与转化区 -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-blue-950/60 border border-blue-500/30 px-4 py-1.5 rounded-full shadow-inner">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-300">
            {content?.badge || "Automated Commercial Sanitization Tech"}
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white">
          Turn Helmet Hygiene Into <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-emerald-400 bg-clip-text text-transparent">24/7 Passive Income</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          {content?.subtitle || "High-throughput touch-free disinfection systems engineered for gas stations, ride-hailing fleets, and smart retail hubs across Southeast Asia."}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a 
            href="#contact-form" 
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-blue-500/25 transition-all duration-200 hover:scale-[1.02]"
          >
            <span>{content?.ctaQuote || "Get Factory Quotation"}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a 
            href="#machines" 
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-slate-900/90 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700/80 font-bold px-8 py-4 rounded-xl transition-all duration-200"
          >
            <span>{content?.ctaSpecs || "Explore Machine Specs"}</span>
          </a>
        </div>

        <div class="pt-6 border-t border-slate-800/80 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <div class="text-2xl font-black font-mono text-white">3-5 Min</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">Fast Wash Cycle</div>
          </div>
          <div>
            <div class="text-2xl font-black font-mono text-emerald-400">99.9%</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">Ozone Sterilization</div>
          </div>
          <div>
            <div class="text-2xl font-black font-mono text-blue-400">100%</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">OEM/ODM Ready</div>
          </div>
        </div>
      </div>

      <!-- 右侧设备浮动展示区 -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="absolute w-72 sm:w-96 h-72 sm:h-96 bg-gradient-to-tr from-blue-600/30 to-indigo-600/20 rounded-full blur-3xl -z-10 animate-pulse"></div>

        <div class="relative w-full max-w-md bg-slate-900/40 border border-slate-700/60 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-2xl flex flex-col items-center">
          
          <div class="relative w-full aspect-[4/5] flex items-center justify-center overflow-hidden">
            {heroImageUrl ? (
              <div class="relative w-full h-full flex items-center justify-center group">
                <div class="absolute bottom-4 w-3/4 h-8 bg-black/60 rounded-full blur-md"></div>
                <img 
                  src={heroImageUrl} 
                  alt={heroImageAlt || "Commercial Helmet Cleaning Machine"} 
                  class="relative z-10 max-h-full max-w-full object-contain drop-shadow-[0_20px_30px_rgba(37,99,235,0.25)] transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                />
              </div>
            ) : (
              <div class="w-full h-full bg-gradient-to-b from-slate-800 to-slate-900/90 rounded-2xl flex flex-col items-center justify-center p-6 border border-slate-700/40">
                <div class="w-20 h-20 rounded-2xl bg-blue-600/20 border border-blue-400/30 flex items-center justify-center mb-4 text-blue-400">
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div class="text-white font-bold text-sm text-center">Flagship OYTK2504-2</div>
                <span class="mt-4 text-[10px] font-mono text-blue-400 bg-blue-950/80 border border-blue-800/60 px-3 py-1 rounded-full">
                  Commercial Grade
                </span>
              </div>
            )}
          </div>

          <div class="absolute -top-3 -left-3 sm:-left-6 bg-slate-900/90 border border-slate-700/80 rounded-2xl px-4 py-2.5 shadow-xl backdrop-blur-md flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm">
              ⚡
            </div>
            <div>
              <div class="text-xs font-bold text-white">3-Min Cycle</div>
              <div class="text-[10px] text-slate-400">Wash & Warm Dry</div>
            </div>
          </div>

          <div class="absolute -bottom-3 -right-3 sm:-right-6 bg-slate-900/90 border border-slate-700/80 rounded-2xl px-4 py-2.5 shadow-xl backdrop-blur-md flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">
              🦠
            </div>
            <div>
              <div class="text-xs font-bold text-white">99.9% Ozone Rate</div>
              <div class="text-[10px] text-slate-400">Dual Medical UV-C</div>
            </div>
          </div>

          <div class="absolute top-8 -right-3 sm:-right-6 bg-slate-900/90 border border-slate-700/80 rounded-xl px-3 py-1.5 shadow-xl backdrop-blur-md flex items-center gap-2">
            <span class="text-xs">💳</span>
            <span class="text-[11px] font-bold text-slate-200">QRIS Ready</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>