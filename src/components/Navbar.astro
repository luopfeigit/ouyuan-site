---
import { translations, supportedLanguages } from '../lib/i18n';

interface Props {
  currentLang?: string;
}

const { currentLang = 'en' } = Astro.props;
const t = translations[currentLang]?.nav || translations['en']?.nav;
const currentPath = Astro.url.pathname.replace(/^\/(en|id|zh)/, '') || '/';

const languageLabels: Record<string, string> = {
  en: 'EN',
  id: 'ID',
  zh: '中文',
};
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 text-slate-800 shadow-sm shadow-blue-900/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- 1. 品牌 Logo -->
      <div class="flex-shrink-0">
        <a href={`/${currentLang}/`} class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-black text-xl shadow-md shadow-blue-500/20 group-hover:scale-105 transition duration-200">
            OY
          </div>
          <div class="flex flex-col">
            <span class="font-black text-xl tracking-tight text-slate-900 group-hover:text-blue-600 transition">OUYUAN</span>
            <span class="text-[10px] text-blue-600 font-mono tracking-widest uppercase font-semibold">Intelligent Tech</span>
          </div>
        </a>
      </div>

      <!-- 2. 桌面端 6 大导航 -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-3 text-base font-semibold text-slate-600">
        <a href={`/${currentLang}/`} class="px-3.5 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/80 transition">
          {t.home || "Home"}
        </a>
        <a href={`/${currentLang}/products/`} class="px-3.5 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/80 transition">
          {t.products || "Products"}
        </a>
        <a href={`/${currentLang}/partner/`} class="px-3.5 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/80 transition">
          {t.partner || "Partner"}
        </a>
        <a href={`/${currentLang}/about/`} class="px-3.5 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/80 transition">
          {t.about || "About Us"}
        </a>
        <a href={`/${currentLang}/faq/`} class="px-3.5 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/80 transition">
          {t.faq || "FAQ"}
        </a>
        <a href={`/${currentLang}/contact/`} class="px-3.5 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50/80 transition">
          {t.contact || "Contact Us"}
        </a>
      </nav>

      <!-- 3. 右侧操作区：多语言切换器 + 询盘按钮 -->
      <div class="hidden lg:flex items-center space-x-4">
        <!-- 语言选择器 -->
        <div class="relative group">
          <button 
            type="button" 
            class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-base font-mono font-bold text-slate-700 hover:text-blue-600 hover:border-blue-300 transition"
          >
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span>{languageLabels[currentLang] || currentLang.toUpperCase()}</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-blue-600 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- 下拉浮层 -->
          <div class="absolute right-0 mt-1 w-32 rounded-xl bg-white border border-slate-200 shadow-xl py-1 text-xs hidden group-hover:block z-50">
            {supportedLanguages.map((lang) => (
              <a 
                href={`/${lang}${currentPath}`}
                class={`block px-4 py-2 hover:bg-blue-50 transition ${currentLang === lang ? 'text-blue-600 font-bold bg-blue-50/50' : 'text-slate-700'}`}
              >
                {lang === 'en' ? 'English (EN)' : lang === 'id' ? 'Indonesia (ID)' : '简体中文 (ZH)'}
              </a>
            ))}
          </div>
        </div>

        <!-- 询盘按钮 -->
        <a 
          href={`/${currentLang}/contact/`} 
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider px-5 py-2.5 rounded-xl shadow-md shadow-blue-500/20 transition duration-200"
        >
          <span>{t.contact || "Get Quote"}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- 4. 移动端汉堡按钮 -->
      <div class="lg:hidden flex items-center space-x-2">
        <button 
          id="mobile-menu-toggle"
          type="button" 
          class="p-2 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 border border-slate-200"
          aria-label="Toggle Menu"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- 5. 移动端抽屉 -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-4 pb-6 space-y-3 shadow-lg">
    <div class="flex flex-col space-y-2 text-sm font-medium">
      <a href={`/${currentLang}/`} class="px-3 py-2 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50">
        {t.home || "Home"}
      </a>
      <a href={`/${currentLang}/products/`} class="px-3 py-2 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50">
        {t.products || "Products"}
      </a>
      <a href={`/${currentLang}/partner/`} class="px-3 py-2 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50">
        {t.partner || "Partner"}
      </a>
      <a href={`/${currentLang}/about/`} class="px-3 py-2 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50">
        {t.about || "About Us"}
      </a>
      <a href={`/${currentLang}/faq/`} class="px-3 py-2 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50">
        {t.faq || "FAQ"}
      </a>
      <a href={`/${currentLang}/contact/`} class="px-3 py-2 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50">
        {t.contact || "Contact Us"}
      </a>
    </div>

    <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
      <span class="text-xs text-slate-400 font-mono uppercase">Language</span>
      <div class="flex items-center space-x-2">
        {supportedLanguages.map((lang) => (
          <a 
            href={`/${lang}${currentPath}`}
            class={`px-3 py-1 rounded-md text-xs font-mono font-bold border transition ${currentLang === lang ? 'bg-blue-600 text-white border-blue-600' : 'bg-slate-100 text-slate-600 border-slate-200'}`}
          >
            {languageLabels[lang] || lang.toUpperCase()}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-2">
      <a 
        href={`/${currentLang}/contact/`} 
        class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider py-3 rounded-xl shadow-md shadow-blue-500/20"
      >
        {t.contact || "Get Quote"}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', !isHidden);
        iconClose.classList.toggle('hidden', isHidden);
      }
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  }
</script>