---
interface Props {
  content: {
    badge: string;
    title: string;
    subtitle: string;
    items: Array<{
      title: string;
      desc: string;
      tag: string;
      metrics: string;
      bgClass: string;
    }>;
  };
}

const { content } = Astro.props;
---

<section class="py-20 bg-slate-50 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-4">
        {content.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {content.title}
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        {content.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {content.items.map((item, index) => (
        <div class="group relative bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div class={`h-32 bg-gradient-to-br ${item.bgClass} p-6 flex flex-col justify-between text-white relative overflow-hidden`}>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-white/10 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500"></div>
            <div class="flex items-center justify-between z-10">
              <span class="text-xs font-semibold px-2.5 py-1 rounded bg-black/25 backdrop-blur-md">
                {item.tag}
              </span>
              <span class="text-xs font-mono opacity-60">0{index + 1}</span>
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-white/90 z-10">
              {item.metrics}
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                {item.title}
              </h3>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                {item.desc}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center text-xs font-semibold text-blue-600 gap-1 group-hover:translate-x-1 transition-transform">
              <span>View operational specs</span>
              <span>→</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>