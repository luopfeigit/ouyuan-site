---
interface Props {
  content: {
    badge: string;
    title: string;
    subtitle: string;
    steps: Array<{ step: string; title: string; desc: string }>;
  };
}

const { content } = Astro.props;
---

<section class="py-20 bg-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-4">
        {content.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {content.title}
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        {content.subtitle}
      </p>
    </div>

    <!-- 4 步执行流程网格 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
      {content.steps.map((item, index) => (
        <div class="relative bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col justify-between hover:shadow-lg transition">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl font-black font-mono text-blue-600/30">
                {item.step}
              </span>
              <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 leading-snug">
              {item.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 text-xs font-bold text-slate-400 uppercase tracking-wider">
            Phase 0{index + 1}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>